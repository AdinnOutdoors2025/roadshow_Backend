# =========================================================
# Roadshow backend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# Lines marked [REQUIRED] have no fallback in code.
# =========================================================

# ---------- Server ----------
# local = local dev; production = live server (only "production" is special)
NODE_ENV=local
PORT=3001
# Optional public path prefix stripped from incoming URLs (live: /api)
API_PREFIX=

# ---------- Database ----------
# [REQUIRED]
MONGODB_URI=

# ---------- CORS ----------
# Comma-separated, no trailing slashes
ALLOWED_ORIGINS=http://localhost:3000
# Allow any *.vercel.app origin (preview deployments): true/false
CORS_ALLOW_VERCEL_PREVIEWS=true

# ---------- Auth / secrets ----------
# [REQUIRED] long random string
JWT_SECRET=
JWT_EXPIRES_IN=7d
# [REQUIRED] must equal the frontend's INTERNAL_API_SECRET
INTERNAL_API_SECRET=
# [REQUIRED] rate-card quotation approval password
ROADSHOW_QUOTATION_APPROVAL_PASSWORD=
# OTP behaviour (see ClientAuthController)
OTP_MODE=

# ---------- Public URLs ----------
# Backend's own public base URL (file links in mails/responses)
LOCAL_BASE_URL=http://localhost:3001
PRODUCTION_BASE_URL=
# Frontend site (links in mails, PDF renderer)
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL_LIVE=
# Mail assets
MAIL_ASSET_BASE_URL_LOCAL=
MAIL_ASSET_BASE_URL_LIVE=
MAIL_LOGO_URL=
MAIL_LOGO_PATH=

# ---------- Storage ----------
# local | space
STORAGE_TYPE=space
CLIENT_AGENCY_PO_DOCUMENTS_STORAGE=
LOCAL_UPLOAD_PATH=public/uploads
PO_DOCUMENT_LOCAL_PATH=public/po_doc_uploads
MAX_FILE_SIZE=
MAX_IMAGE_SIZE=
MAX_VIDEO_SIZE=
# DigitalOcean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=sgp1
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_CDN_BASE=
# Cloudinary (legacy upload code)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AWS S3 (only used by the /uploadaws route)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# ---------- Mail (external PHP mail APIs) ----------
EXTERNAL_API_URL=
CODECREATION_API_URL=
ROADSHOW_CAMPAIGN_MAIL_API_URL=
ROADSHOW_CAMPAIGN_MAIL_TO=
ROADSHOW_CAMPAIGN_MAIL_CC=
ROADSHOW_RATECARD_MAIL_API_URL=
ROADSHOW_APPROVAL_MAIL_TO=
ROADSHOW_APPROVAL_MAIL_CC=
ROADSHOW_APPROVAL_MAIL_TEST_ONLY=false
ROADSHOW_ENQUIRY_MAIL_API_URL=
ROADSHOW_CONTACT_MAIL_TO=
ROADSHOW_CONTACT_MAIL_CC=
ROADSHOW_FOOTER_MAIL_TO=
ROADSHOW_FOOTER_MAIL_CC=
PROJECT_CODE_AUTO_MAIL_TO=
PROJECT_CODE_AUTO_MAIL_CC=

# ---------- SMS (Nettyfish) ----------
# [REQUIRED]
NETTYFISH_API_KEY=
NETTYFISH_BASE_URL=https://retailsms.nettyfish.com/api/mt/SendSMS
NETTYFISH_ROUTE=17
NETTYFISH_SENDER_ID=
NETTYFISH_TEMPLATE_ID=
NETTYFISH_OTP_TEMPLATE_ID=
NETTYFISH_ORDER_ADMIN_TEMPLATE_ID=
NETTYFISH_ORDER_USER_TEMPLATE_ID=
NETTYFISH_SEND_SMS_IN_DEV=false
SMS_MODE=
ADMIN_SMS_NUMBERS=

# ---------- GST verification (Meon) ----------
MEON_BASE_URL=https://ocr.meon.co.in
MEON_COMPANY_ID=
MEON_EMAIL=
MEON_PASSWORD=
MEON_COMPANY_NAME=
MEON_SECRET_TOKEN=

# ---------- GPS (Vamosys) ----------
# [REQUIRED] account id (can mint API keys — treat as a secret)
VAMOSYS_USER_ID=
VAMOSYS_GROUP_ID=
VAMOSYS_CONTACT_EMAIL=
VAMOSYS_CONTACT_PHONE=
VAMOSYS_API_BASE_URL=https://api.vamosys.com
VAMOSYS_LOCATIONS_URL=http://api.vamosys.com/apiMobile/getVehicleLocations
VAMOSYS_HISTORY_URL=https://gpsvtsprobend.vamosys.com/getVehicleHistory

# ---------- Misc ----------
DISABLE_ROADSHOW_SHORT_URL=false

# ---------- Business rules ----------
DEFAULT_PROMOTER_CHARGE=1000
DEFAULT_PROMOTER_CHARGE_PER_DAY=1000
MAX_DISCOUNT_PERCENT=15
GST_PERCENT=18
CAMPAIGN_HOURS_PER_DAY=8
NEGOTIATION_DISCOUNT_PERCENT=10
DEFAULT_WORK_START_HOUR=
DEFAULT_WORK_END_HOUR=
# Must match the frontend's RTO_CYCLE_DAYS (src/BaseUrl.tsx)
RTO_CYCLE_DAYS=30
